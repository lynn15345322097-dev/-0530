<view class="page">
  <view class="header">
    <text class="header-title">家族展厅</text>
    <text class="header-sub">已解锁 {{unlockedCount}}/{{totalCount}} 件展品</text>
  </view>

  <view class="gallery-grid">
    <view
      wx:for="{{exhibits}}"
      wx:key="id"
      class="exhibit-card {{item.unlocked ? 'unlocked' : 'locked'}}"
      data-id="{{item.id}}"
      bindtap="openFullscreen"
    >
      <image
        wx:if="{{item.unlocked}}"
        class="exhibit-img"
        src="{{item.src}}"
        mode="aspectFill"
      />
      <view wx:if="{{!item.unlocked}}" class="locked-placeholder">
        <text class="locked-icon">❓</text>
        <text class="locked-text">未解锁</text>
      </view>
      <view class="exhibit-label">{{item.unlocked ? item.title : '???'}}</view>
    </view>

    <view class="exhibit-card upload-card" bindtap="startUpload">
      <view class="locked-placeholder">
        <text class="upload-icon">📷</text>
        <text class="upload-text">上传老照片</text>
      </view>
    </view>
  </view>

  <view class="task-bar">
    <view class="task-header">
      <text class="task-title">🔍 家族侦探任务栏</text>
    </view>
    <view
      wx:for="{{tasks}}"
      wx:key="id"
      class="task-item"
      data-id="{{item.id}}"
      bindtap="toggleTask"
    >
      <view class="task-check {{item.completed ? 'checked' : ''}}">
        <text wx:if="{{item.completed}}">✓</text>
      </view>
      <view class="task-body">
        <text class="task-label {{item.completed ? 'done' : ''}}">{{item.title}}</text>
        <text class="task-reward">奖励：{{item.reward}}</text>
      </view>
    </view>
  </view>

  <view class="fullscreen-mask" wx:if="{{showFullscreen}}" bindtap="closeFullscreen">
    <view class="fullscreen-close" bindtap="closeFullscreen">
      <text>✕</text>
    </view>
    <image
      class="fullscreen-img"
      src="{{fullscreenPhoto.src}}"
      mode="aspectFit"
    />
    <text class="fullscreen-title">{{fullscreenPhoto.title}}</text>
  </view>

  <view class="upload-mask" wx:if="{{showUpload}}" catchtap="cancelUpload">
    <view class="upload-modal" catchtap="">
      <text class="upload-modal-title">上传老照片</text>
      <image wx:if="{{previewSrc}}" class="upload-preview" src="{{previewSrc}}" mode="aspectFill" />
      <view wx:if="{{!previewSrc}}" class="upload-pick" bindtap="pickImage">
        <text class="pick-icon">📁</text>
        <text>点击选择照片</text>
      </view>
      <input class="upload-input" placeholder="照片名称，如：爷爷的军装照" value="{{uploadTitle}}" bindinput="onTitleInput" />
      <input class="upload-input" placeholder="解锁关键词，如：军装" value="{{uploadKeyword}}" bindinput="onKeywordInput" />
      <view class="upload-actions">
        <view class="btn-secondary upload-cancel" bindtap="cancelUpload">取消</view>
        <view class="btn-primary upload-confirm" bindtap="confirmUpload">上传</view>
      </view>
    </view>
  </view>
</view>
