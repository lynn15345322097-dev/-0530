.page {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  padding: 48rpx 0 40rpx;
}

.header {
  text-align: center;
  margin-bottom: 40rpx;
}

.header-title {
  font-size: 56rpx;
  font-weight: 700;
  color: #2C1810;
  display: block;
}

.header-sub {
  font-size: 36rpx;
  color: #8B7355;
  margin-top: 12rpx;
  display: block;
}

/* Gallery Grid */
.gallery-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 0 32rpx;
  gap: 24rpx;
  justify-content: center;
}

.exhibit-card {
  width: 330rpx;
  border-radius: 24rpx;
  overflow: hidden;
  background: #FFFFFF;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
  transition: transform 0.2s;
}

.exhibit-card.unlocked:active {
  transform: scale(0.96);
}

.exhibit-img {
  width: 100%;
  height: 330rpx;
  display: block;
}

.locked-placeholder {
  width: 100%;
  height: 330rpx;
  background: #E8D5C4;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
}

.locked-icon {
  font-size: 80rpx;
}

.locked-text {
  font-size: 32rpx;
  color: #8B7355;
}

.exhibit-label {
  padding: 20rpx;
  text-align: center;
  font-size: 36rpx;
  font-weight: 600;
  color: #2C1810;
  background: #FFFFFF;
}

/* Task Bar */
.task-bar {
  margin: 48rpx 32rpx 120rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.08);
}

.task-header {
  margin-bottom: 24rpx;
  padding-bottom: 20rpx;
  border-bottom: 3rpx solid #E8D5C4;
}

.task-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #2C1810;
}

.task-item {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 24rpx 0;
}

.task-item + .task-item {
  border-top: 2rpx solid #F5E6D8;
}

.task-check {
  width: 56rpx;
  height: 56rpx;
  border-radius: 14rpx;
  border: 4rpx solid #C44536;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: #FFFFFF;
  flex-shrink: 0;
  transition: all 0.2s;
}

.task-check.checked {
  background: #C44536;
}

.task-body {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  flex: 1;
}

.task-label {
  font-size: 36rpx;
  color: #2C1810;
  font-weight: 500;
  line-height: 1.4;
}

.task-label.done {
  text-decoration: line-through;
  color: #8B7355;
}

.task-reward {
  font-size: 30rpx;
  color: #E8A840;
  font-weight: 600;
}

/* Fullscreen */
.fullscreen-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.9);
  z-index: 999;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx;
}

.fullscreen-close {
  position: absolute;
  top: 60rpx;
  right: 40rpx;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #FFFFFF;
}

.fullscreen-img {
  width: 100%;
  max-height: 70vh;
  border-radius: 24rpx;
}

.fullscreen-title {
  margin-top: 32rpx;
  font-size: 44rpx;
  font-weight: 700;
  color: #FFFFFF;
}
