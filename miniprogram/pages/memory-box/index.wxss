.page {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-height: 100vh;
  padding: 48rpx 0 80rpx;
}

.header {
  text-align: center;
  margin-bottom: 40rpx;
}

.header-title {
  font-size: 56rpx;
  font-weight: 700;
  color: #2C1810;
  display: block;
}

.header-sub {
  font-size: 36rpx;
  color: #8B7355;
  margin-top: 12rpx;
  display: block;
}

/* Photo Stage */
.photo-stage {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  padding: 0 16rpx;
  box-sizing: border-box;
}

.photo-card {
  width: 560rpx;
  height: 700rpx;
  border-radius: 32rpx;
  overflow: hidden;
  position: relative;
  background: #E8D5C4;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.15);
  transition: transform 0.4s ease;
}

.photo-card.unlocking {
  transform: scale(1.05);
}

.photo-img {
  width: 100%;
  height: 100%;
  transition: filter 2s ease-out;
}

.photo-img.blurred {
  filter: blur(30px);
}

.photo-img.clear {
  filter: blur(0px);
}

.photo-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: rgba(44, 24, 16, 0.35);
  transition: opacity 1.5s ease;
}

.overlay-icon {
  font-size: 100rpx;
  margin-bottom: 24rpx;
}

.overlay-text {
  font-size: 36rpx;
  color: #FFFFFF;
  font-weight: 600;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.3);
  line-height: 1.6;
}

.photo-label {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx;
  background: linear-gradient(transparent, rgba(0,0,0,0.6));
  color: #FFFFFF;
  font-size: 40rpx;
  font-weight: 600;
  text-align: center;
}

/* Navigation */
.nav-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.9);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  font-weight: 700;
  color: #2C1810;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.1);
  flex-shrink: 0;
  margin: 0 8rpx;
}

/* Dots */
.dots {
  display: flex;
  gap: 16rpx;
  margin-top: 32rpx;
}

.dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #D4C4B0;
  transition: all 0.3s;
}

.dot.active {
  width: 40rpx;
  border-radius: 8rpx;
  background: #C44536;
}

.dot.unlocked-dot {
  background: #E8A840;
}

.dot.active.unlocked-dot {
  background: #2E7D32;
}

/* Hint */
.unlock-hint {
  margin-top: 24rpx;
  font-size: 36rpx;
  color: #C44536;
  font-weight: 600;
  text-align: center;
  min-height: 56rpx;
  animation: fadeInOut 2.5s ease;
}

@keyframes fadeInOut {
  0% { opacity: 0; transform: translateY(10rpx); }
  15% { opacity: 1; transform: translateY(0); }
  75% { opacity: 1; }
  100% { opacity: 0; }
}

/* Record Button */
.record-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 48rpx;
  gap: 20rpx;
}

.record-btn {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: #C44536;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 32rpx rgba(196, 69, 54, 0.35);
  transition: all 0.3s;
}

.record-btn:active {
  transform: scale(0.92);
}

.record-btn.recording {
  background: #A8382C;
  box-shadow: 0 0 0 16rpx rgba(196, 69, 54, 0.25);
  animation: pulse 1s infinite;
}

.record-btn.disabled {
  opacity: 0.5;
  pointer-events: none;
}

.record-btn.unlocked-state {
  background: #2E7D32;
  box-shadow: 0 8rpx 32rpx rgba(46, 125, 50, 0.35);
}

@keyframes pulse {
  0% { box-shadow: 0 0 0 0 rgba(196, 69, 54, 0.4); }
  70% { box-shadow: 0 0 0 32rpx rgba(196, 69, 54, 0); }
  100% { box-shadow: 0 0 0 0 rgba(196, 69, 54, 0); }
}

.record-icon {
  font-size: 64rpx;
}

.record-label {
  font-size: 36rpx;
  color: #8B7355;
  font-weight: 500;
}
